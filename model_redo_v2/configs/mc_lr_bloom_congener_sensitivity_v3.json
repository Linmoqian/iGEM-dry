{
  "target": "mc_lr",
  "panel": "bloom_augmented",
  "exclude_sources": ["Uruguay_Rio_de_la_Plata"],
  "split_protocol": "waterbody_ood",
  "n_folds": 5,
  "test_fold": 0,
  "validation_fold": 1,
  "models": ["xgb_aft", "xgb_quantile", "catboost_quantile", "tabm_censored"],
  "stacking_objective": "distributional",
  "stacking_quantile_loss_weight": 0.25,
  "stacking_width_penalty": 0.05,
  "stacking_max_log_width": 4.0,
  "stacking_l2_penalty": 0.01,
  "risk_thresholds_ug_l": [],
  "xgb_aft": {"tree_method": "hist", "device": "cuda"},
  "xgb_quantile": {"tree_method": "hist", "device": "cuda"},
  "catboost_quantile": {
    "task_type": "GPU",
    "devices": "0",
    "gpu_ram_part": 0.65,
    "thread_count": 16
  },
  "tabm_censored": {
    "device": "cuda",
    "batch_size": 512,
    "ensemble_size": 16,
    "min_scale": 0.03,
    "max_scale": 2.0,
    "amp": true
  }
}
